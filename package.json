{
  "name": "flowid",
  "version": "1.0.0",
  "private": true,
  "description": "FlowID — OAuth 2.1 / OpenID Connect провайдер с регистрацией, входом по паролю и через VK ID",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "demo": "node examples/demo-client/server.js",
    "test": "node scripts/vk.mjs && node scripts/e2e.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:vk": "node scripts/vk.mjs"
  }
}
