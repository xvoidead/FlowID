# --- Сервер -------------------------------------------------------------
PORT=3000
ISSUER=http://localhost:3000
NODE_ENV=development

# Только если FlowID стоит за своим nginx/Caddy: тогда адрес клиента берётся
# из X-Forwarded-For. Без прокси оставьте 0 — иначе лимит попыток входа обходится.
TRUST_PROXY=0

# Секрет для подписи сессионных cookie и служебных состояний (обязательно смените)
APP_SECRET=change-me-please-32-bytes-minimum-secret

# --- VK ID --------------------------------------------------------------
# https://id.vk.com/about/business/go  →  создайте приложение,
# в «Доверенный redirect URL» добавьте  http://localhost:3000/auth/vk/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/auth/vk/callback

# --- Почта --------------------------------------------------------------
# Без SMTP письма печатаются в консоль (удобно для разработки)
MAIL_FROM=FlowID <no-reply@flowid.local>

# Опционально: своя папка для базы и ключей (по умолчанию ./data)
# DATA_DIR=data
